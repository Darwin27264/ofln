{
  "name": "ofln",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android:clean": "cd android && ./gradlew clean",
    "android:uninstall": "adb uninstall com.ofln",
    "android:clean-emulator": "adb shell pm trim-caches 500M && adb uninstall com.ofln",
    "android:check-storage": "adb shell df -h",
    "android:install": "cd android && ./gradlew installDebug",
    "android:build-release": "cd android && ./gradlew assembleRelease",
    "android:install-release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:test-release": "npm run android:build-release && npm run android:install-release"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-documents/picker": "^10.1.7",
    "@types/uuid": "^10.0.0",
    "axios": "^1.8.4",
    "llama.rn": "^0.5.0",
    "react": "19.0.0",
    "react-native": "0.78.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-svg": "^15.11.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-safe-area-context": "^5.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.1",
    "@react-native/eslint-config": "0.78.1",
    "@react-native/metro-config": "0.78.1",
    "@react-native/typescript-config": "0.78.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
