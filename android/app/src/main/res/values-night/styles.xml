<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        
        <!-- Contained look (don't draw under system bars) -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowFullscreen">false</item>
        
        <!-- System bar colors (dark mode defaults) -->
        <item name="android:statusBarColor">@color/app_status_bar</item>
        <item name="android:navigationBarColor">@color/app_nav_bar</item>
        
        <!-- In dark theme we want light (white) icons -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>

